# Copy to .env (never commit .env). All values are optional.

# Raises GitHub API rate limits; required for private repos and the Project Status pages. Tip: `gh auth token`
# (project boards need the read:project scope: `gh auth refresh -s read:project`)
GITHUB_TOKEN=

# Only for PRIVATE Google Docs (expires after 1 hour). Get one at https://developers.google.com/oauthplayground
# with scope https://www.googleapis.com/auth/drive.readonly
GOOGLE_ACCESS_TOKEN=

# Host folder mounted read-only at /sources for "local" README entries (default: ../.. = the folder holding your repos)
SOURCES_DIR=../..

# Box Drive folder mounted read-only at /box for "boxFolders" in docs-sources.json (macOS default shown)
# BOX_DIR=${HOME}/Library/CloudStorage/Box-Box

# Website address used in MCP search-result links (default http://localhost:3000). E.g. your GitHub Pages URL.
DOCS_SITE_URL=
