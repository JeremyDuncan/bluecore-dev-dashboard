# Copy to .env.notebooks (never commit it). Logins notebooks use for the DEPLOYED environments; only the
# JupyterLab container gets these (not GITHUB_TOKEN), and the MCP server hides their values from AI agents.
# Each environment in docs-sources.json (projectStatus.versionDrift.environments) reads BLUECORE_<NAME>_*.
# Everything is optional: without a login, notebooks still read the public endpoints (health, the API).
# Notebooks must be on (JUPYTER_NOTEBOOK=true in .env). After a change: docker compose --profile notebooks up -d jupyter

# Airflow REST API (a user, or a ready-made API token)
BLUECORE_DEV_AIRFLOW_USER=
BLUECORE_DEV_AIRFLOW_PASSWORD=
# BLUECORE_DEV_AIRFLOW_TOKEN=

# Keycloak, for Blue Core API endpoints that need a login
BLUECORE_DEV_KEYCLOAK_USERNAME=
BLUECORE_DEV_KEYCLOAK_PASSWORD=
# BLUECORE_DEV_KEYCLOAK_CLIENT_ID=bluecore_api

# Postgres, only if you can reach it (e.g. through an SSH tunnel to host.docker.internal:15432)
# BLUECORE_DEV_DB_URL=postgresql://user:password@host.docker.internal:15432/bluecore

BLUECORE_STAGE_AIRFLOW_USER=
BLUECORE_STAGE_AIRFLOW_PASSWORD=
BLUECORE_STAGE_KEYCLOAK_USERNAME=
BLUECORE_STAGE_KEYCLOAK_PASSWORD=
