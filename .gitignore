node_modules/
build/
.docusaurus/
.cache-loader/
.DS_Store
.env
.chat.pid
.chat.log
# generated at build time
static/llms.txt
static/llms-full.txt

# Pulled from GitHub on every sync/build, never committed
docs/blue-core-repos/
docs/blue-core-wiki/

# Local-only content: internal docs that exist only on machines that have the source files
docs/google-drive/
docs/box/
docs/design/
docs/project-status/
# Whatever developers drop into imports/ (Drive downloads); only the folder layout is committed
imports/**
!imports/**/
!imports/README.md
!imports/**/.gitkeep

# Your notes vault (the Notes page; NOTES_DIR can point elsewhere). Anchored with "/" so it only
# matches the vault at the repo root: on macOS git ignores case, so a bare "notes/" also hid
# src/components/Notes/ and broke the build on GitHub.
/notes/

# Personal editor / agent settings
.idea/
.claude/settings.local.json
