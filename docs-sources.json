  "boxFolders": [
    {
      "dir": "/box/Blue Core MVP planning",
      "slug": "blue-core-mvp-planning",
      "title": "Blue Core MVP Planning",
      "_note": "/box is the BOX_DIR folder from .env (Box Drive), mounted read-only by docker-compose",
      "enabled": true
    }
  ],
  "readmes": [
    {
      "repo": "blue-core-lod/bluecore-stack",
      "ref": "main",
      "files": [
        "README.md",
        "docs/**/*.md",
        "training/**/*.md"
      ],
      "slug": "bluecore-stack",
      "title": "Bluecore Stack",
      "enabled": false,
      "_note": "Covered by the blue-core-lod entry in githubOrgs"
    },
    {
      "local": "/sources/some-local-checkout",
      "path": "README.md",
      "slug": "local-example",
      "title": "Local checkout example",
      "githubUrl": "https://github.com/YOUR_GITHUB_ORG/some-repo",
      "enabled": false
    }
  ],
  "githubOrgs": [
    {
      "org": "blue-core-lod",
      "dir": "blue-core-repos",
      "title": "Blue Core Repos",
      "description": "Documentation from each repository in the blue-core-lod GitHub organization.",
      "position": 20,
      "files": [
        "README.md",
        "docs/**/*.md",
        "doc/**/*.md",
        "training/**/*.md"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/vendor/**",
        ".github/**"
      ],
      "includeWikis": true,
      "includeArchived": false,
      "includeForks": [
        "graph-toolbox",
        "marva_editor"
      ],
      "includePrivate": false,
      "skipRepos": [],
      "enabled": true,
      "wikiSection": {
        "dir": "blue-core-wiki",
        "title": "Blue Core Wiki",
        "mainRepo": "bluecore_info",
        "position": 30
      }
    }
  ],
  "codeDocs": [
    {
      "name": "example-typescript-lib",
      "cwd": "../../some-ts-project",
      "command": "npx typedoc --plugin typedoc-plugin-markdown --out ./.docs-out src/index.ts",
      "output": ".docs-out",
      "enabled": false
    }
  ],
  "projectStatus": {
    "dir": "project-status",
    "title": "Project Status",
    "description": "Live status of the Blue Core GitHub project board, open issues and the latest releases of each repository.",
    "position": 10,
    "projects": [
      {
        "org": "blue-core-lod",
        "number": 5,
        "slug": "blue-core-mvp-board"
      }
    ],
    "issues": {
      "org": "blue-core-lod",
      "includeArchived": false,
      "includePrivate": false,
      "skipRepos": [],
      "includeForks": [
        "graph-toolbox",
        "marva_editor"
      ]
    },
    "_note": "Needs GITHUB_TOKEN with the read:project scope. Output is git-ignored (the board is private).",
    "enabled": true,
    "releases": {
      "org": "blue-core-lod",
      "perRepo": 20,
      "includeForks": [
        "graph-toolbox",
        "marva_editor"
      ]
    },
    "integrationTests": [
      {
        "org": "blue-core-lod",
        "repo": "bluecore-stack",
        "workflow": "bluecore-integration-test.yml",
        "title": "Bluecore Integration Test",
        "runs": 100,
        "parseLogs": 30,
        "callers": {
          "api-integration": "bluecore_api",
          "workflows-integration": "bluecore-workflows",
          "models-integration": "bluecore-models",
          "sinopia-integration": "sinopia_editor",
          "marva-integration": "marva_editor"
        },
        "_note": "callers: the run-name prefix each repo's stack-integration.yml dispatches with → that repo, so each run links to the PR that started it"
      }
    ],
    "repoTests": [
      {
        "repo": "bluecore_api",
        "workflow": "test.yml",
        "title": "bluecore_api"
      },
      {
        "repo": "bluecore-models",
        "workflow": "test.yml",
        "title": "bluecore-models"
      },
      {
        "repo": "bluecore-workflows",
        "workflow": "test.yml",
        "title": "bluecore-workflows"
      },
      {
        "repo": "bluecore-client",
        "workflow": "test.yml",
        "title": "bluecore-client"
      },
      {
        "repo": "marc-bibframe",
        "workflow": "test.yml",
        "title": "marc-bibframe"
      },
      {
        "repo": "bibframe-json",
        "workflow": "test.yml",
        "title": "bibframe-json"
      },
      {
        "repo": "sinopia_editor",
        "workflow": "test.yml",
        "title": "sinopia_editor"
      },
      {
        "repo": "marva_editor",
        "workflow": "unit_tests.yml",
        "title": "marva_editor (unit)",
        "slug": "tests-marva_editor-unit"
      }
    ],
    "_repoTestsNote": "Each repo's own test workflow: one page per entry under Tests. runs (default 50) and parseLogs (default 10) keep GitHub API use low.",
    "pullRequests": {
      "staleDays": 14,
      "_note": "Open PRs in the same repos as issues (issues.org and its filters). Stale = no update for staleDays."
    },
    "versionDrift": {
      "stack": {
        "repo": "bluecore-stack",
        "files": [
          "compose-base.yaml",
          "compose.yaml"
        ]
      },
      "services": [
        {
          "name": "Blue Core API",
          "repo": "bluecore_api",
          "imageVar": "BLUECORE_API_IMAGE",
          "health": "/api/health"
        },
        {
          "name": "Workflows (Airflow)",
          "repo": "bluecore-workflows",
          "imageVar": "BLUECORE_WORKFLOWS_IMAGE",
          "health": "/workflows/health"
        },
        {
          "name": "Sinopia",
          "repo": "sinopia_editor",
          "imageVar": "SINOPIA_IMAGE",
          "health": "/sinopia/health"
        },
        {
          "name": "Marva",
          "repo": "marva_editor",
          "imageVar": "MARVA_IMAGE",
          "branch": "bluecore-main",
          "imageTracksBranch": true,
          "health": "/marva/health"
        }
      ],
      "libraries": [
        {
          "name": "bluecore-models",
          "repo": "bluecore-models",
          "package": "bluecore-models",
          "usedBy": [
            "bluecore_api",
            "bluecore-workflows"
          ]
        }
      ],
      "_note": "Each service: its latest release vs the image the stack's compose files use (imageVar). imageTracksBranch: the image is rebuilt on every push to branch, not on releases. Libraries: latest release vs the version each service locks in uv.lock. environments: deployed sites; each service's health path must return JSON with \"version\".",
      "environments": [
        {
          "name": "dev",
          "url": "https://dev.bcld.info"
        },
        {
          "name": "stage",
          "url": "https://stage.bcld.info"
        }
      ]
    }
  },
  "apiReference": [
    {
      "slug": "bluecore-api",
      "name": "Blue Core API",
      "specUrl": "https://dev.bcld.info/api/openapi.json",
      "baseUrl": "https://dev.bcld.info/api",
      "docsUrl": "https://dev.bcld.info/api/docs",
      "repo": "bluecore_api",
      "_note": "The dev environment. Point specUrl/baseUrl at production when there is one.",
      "enabled": true
    }
  ]
}
