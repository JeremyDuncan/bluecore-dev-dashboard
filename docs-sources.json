      "folder": "0AAhAJgoVw1ArUk9PVA",
      "slug": "shared-drive",
      "title": "Shared Drive Docs",
      "enabled": false
    },
    {
      "id": "PASTE_GOOGLE_DOC_ID_HERE",
      "slug": "example-google-doc",
      "title": "Example single Google Doc",
      "enabled": false
    }
  ],
  "driveDownloads": [
    {
      "dir": "imports/shared-drive",
      "slug": "shared-drive",
      "title": "Shared Drive Docs",
      "driveUrl": "https://drive.google.com/drive/folders/0AAhAJgoVw1ArUk9PVA",
      "enabled": true
    }
